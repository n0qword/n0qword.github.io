---
import { frontmatter as SITE } from "../data/home.md";

export interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const siteName = SITE.name;
const year = String(new Date().getFullYear());
const ogImage = image ?? "";
const siteUrl = "https://n0qword.github.io";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description ?? title} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? title} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl + Astro.url.pathname} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description ?? title} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="preload" as="style" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
    </noscript>

    <style is:global>
      :root {
        --bg: #06070b;
        --bg1: #0d0e12;
        --bg2: #16171c;
        --line: #222328;
        --fg: #e0e0e0;
        --fg2: #a0a0a0;
        --fg3: #666;
        --red: #e54d2e;
        --red-dim: #c4422a;
        --red-bg: #1a0e0b;
        --mono: "JetBrains Mono", monospace;
        --body: "Inter", system-ui, sans-serif;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }
      ::selection { background: rgba(229, 77, 46, 0.25); }

      html { font-size: 16px; }

      body {
        font-family: var(--body);
        font-weight: 400;
        background: var(--bg);
        color: var(--fg);
        line-height: 1.75;
        padding: 2.5rem 1.5rem 5rem;
        max-width: 700px;
        margin: 0 auto;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      a { color: inherit; text-decoration: none; }
      a:hover { color: var(--red); }

      .site-header {
        margin-bottom: 2.5rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid var(--line);
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .site-header .site-name {
        font-family: var(--mono);
        font-size: 0.85rem;
        font-weight: 500;
        letter-spacing: -0.01em;
        color: var(--fg);
      }

      .site-header nav {
        display: flex;
        gap: 1.5rem;
      }
      .site-header nav a {
        font-size: 0.82rem;
        font-weight: 500;
        color: var(--fg2);
        transition: color 0.15s;
      }
      .site-header nav a:hover { color: var(--fg); }

      main { flex: 1; }

      h1 {
        font-size: clamp(1.5rem, 4vw, 2rem);
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 0.4rem;
        letter-spacing: -0.02em;
      }

      h2 {
        font-size: 1.15rem;
        font-weight: 600;
        margin-top: 2rem;
        letter-spacing: -0.01em;
      }
      h3 {
        font-size: 0.95rem;
        font-weight: 600;
        margin-top: 1.5rem;
      }
      p, li { margin-bottom: 0.8rem; }
      ul, ol { padding-left: 1.2rem; }

      code {
        font-family: var(--mono);
        font-size: 0.82em;
        background: var(--bg2);
        padding: 0.15em 0.4em;
        border-radius: 4px;
      }
      pre {
        background: var(--bg1);
        padding: 1rem 1.1rem;
        border-radius: 8px;
        overflow-x: auto;
        margin-bottom: 1.2rem;
        border: 1px solid var(--line);
        font-size: 0.78em;
        line-height: 1.6;
      }
      pre code { background: none; padding: 0; border-radius: 0; }

      img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        border: 1px solid var(--line);
      }

      blockquote {
        border-left: 3px solid var(--red-dim);
        padding: 0.6rem 0 0.6rem 1rem;
        color: var(--fg2);
        margin: 1.2rem 0;
      }

      hr {
        border: none;
        height: 1px;
        background: var(--line);
        margin: 2.5rem 0;
      }

      .page-desc {
        color: var(--fg2);
        font-size: 0.9rem;
        margin-bottom: 1.5rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid var(--line);
      }
      .page-desc .count {
        font-family: var(--mono);
        font-size: 0.75rem;
        color: var(--red);
      }

      .post-list {
        list-style: none;
        padding: 0;
      }
      .post-list li {
        margin: 0;
        padding: 1rem 0;
        border-bottom: 1px solid var(--line);
      }
      .post-list li:first-child {
        padding-top: 0;
      }
      .post-list li.hidden-filtered,
      .post-list li.hidden-more {
        display: none;
      }

      .post-item {
        display: block;
      }
      .post-item:hover { color: inherit; }

      .post-item-title {
        font-weight: 600;
        font-size: 0.95rem;
        line-height: 1.4;
        margin-bottom: 0.25rem;
        transition: color 0.15s;
      }
      .post-item:hover .post-item-title { color: var(--red); }

      .post-item-excerpt {
        font-size: 0.85rem;
        color: var(--fg2);
        line-height: 1.6;
        margin-bottom: 0.4rem;
      }

      .post-item-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        font-family: var(--mono);
        font-size: 0.7rem;
        color: var(--fg3);
      }

      .post-item-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
      }

      .tag {
        display: inline-block;
        padding: 0.1rem 0.4rem;
        font-family: var(--mono);
        font-size: 0.65rem;
        font-weight: 500;
        text-transform: lowercase;
        border: 1px solid var(--red-dim);
        border-radius: 3px;
        color: var(--red);
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s;
      }
      .tag:hover {
        background: var(--red-bg);
        border-color: var(--red);
      }

      .post-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        font-family: var(--mono);
        font-size: 0.7rem;
        color: var(--fg3);
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--line);
      }
      .post-meta .sep { color: var(--line); }

      .tags-list {
        display: inline-flex;
        flex-wrap: wrap;
        gap: 0.3rem;
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .tags-list li { margin: 0; }

      .search-bar {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        margin-bottom: 1.25rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid var(--line);
      }
      .search-input {
        font-family: var(--mono);
        font-size: 0.8rem;
        padding: 0.5rem 0.75rem;
        background: var(--bg1);
        border: 1px solid var(--line);
        border-radius: 6px;
        color: var(--fg);
        outline: none;
        transition: border-color 0.15s;
      }
      .search-input:focus {
        border-color: var(--red-dim);
      }
      .search-input::placeholder { color: var(--fg3); }

      .social-links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.82rem;
      }
      .social-links a {
        color: var(--fg2);
        transition: color 0.15s;
      }
      .social-links a:hover { color: var(--red); }
      .social-sep { color: var(--line); font-size: 0.7rem; }

      .tag-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
      }
      .tag-filter {
        font-family: var(--mono);
        font-size: 0.65rem;
        text-transform: lowercase;
        padding: 0.15rem 0.45rem;
        border: 1px solid var(--line);
        border-radius: 3px;
        color: var(--fg3);
        background: transparent;
        cursor: pointer;
        transition: border-color 0.15s, color 0.15s, background 0.15s;
      }
      .tag-filter:hover {
        border-color: var(--red-dim);
        color: var(--red);
      }
      .tag-filter.active {
        border-color: var(--red);
        color: var(--red);
        background: var(--red-bg);
      }

      .btn-show-more {
        display: block;
        width: 100%;
        margin-top: 0.5rem;
        padding: 0.6rem;
        font-family: var(--mono);
        font-size: 0.7rem;
        color: var(--fg3);
        background: transparent;
        border: 1px solid var(--line);
        border-radius: 6px;
        cursor: pointer;
        transition: border-color 0.15s, color 0.15s;
      }
      .btn-show-more:hover {
        border-color: var(--red-dim);
        color: var(--red);
      }
      .btn-show-more.hidden { display: none; }

      .post-cover {
        display: block;
        width: 100%;
        margin: 0 0 1.5rem;
        aspect-ratio: 21 / 9;
        object-fit: cover;
        border-radius: 8px;
      }

      .post-footer {
        margin-top: 2.5rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--line);
        font-family: var(--mono);
        font-size: 0.75rem;
      }
      .post-footer a { color: var(--red); }
      .post-footer a:hover { text-decoration: underline; }

      footer.pg-footer {
        margin-top: 4rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--line);
        font-family: var(--mono);
        font-size: 0.7rem;
        color: var(--fg3);
        text-align: center;
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <a class="site-name" href="/">home</a>
      <nav>
        <a href="/posts/">posts</a>
        <a href="/notes/">notes</a>
        <a href="/talks/">talks</a>
        <a href="/about/">about</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="pg-footer">
      © {year} {SITE.author} — {siteName}
    </footer>
  </body>
</html>
