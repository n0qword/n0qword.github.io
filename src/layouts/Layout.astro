---
/**
 * Layout.astro — Base layout template for every page.
 *
 * Imports site metadata from src/data/home.md and provides:
 *   - HTML shell with <head> (fonts, meta, favicon)
 *   - Global CSS including red/black palette, CRT scanline overlay,
 *     typography, and component styles (post list, tags, search, etc.)
 *   - Header (.site-header) with logo + nav
 *   - Main content slot
 *   - Footer with copyright
 *
 * Props:
 *   title       — Page <title> (required)
 *   description — Meta description (optional, falls back to title)
 */

import { frontmatter as SITE } from "../data/home.md";

export interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description ?? title} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: Barlow (body), Barlow Condensed (headings), IBM Plex Mono (code/ui) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@300;400;600&family=Barlow+Condensed:wght@600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

    <style is:global>
      /* ── Color palette ──────────────────────────────────
         Red/black terminal-inspired theme.
         --bg        = deep black background
         --red       = accent (#d94f3d, blood-orange)
         --red-dim   = muted red for borders/hover states
         --red-bg    = very dark red for hover backgrounds
         --line      = subtle border color
         --fg        = primary text (warm off-white)
         --fg2       = secondary text
         --fg3       = muted text (dates, metadata)
      */
      :root {
        --red: #d94f3d;
        --red-dim: #7a2c22;
        --red-bg: #1a0f0d;
        --bg: #0a0a0b;
        --bg1: #111113;
        --line: #2a2a2e;
        --fg: #e8e6e1;
        --fg2: #9a9894;
        --fg3: #5a5857;
        --mono: "IBM Plex Mono", monospace;
        --cond: "Barlow Condensed", sans-serif;
        --body: "Barlow", sans-serif;
      }

      /* ── Reset ─────────────────────────────────────────── */
      * { margin: 0; padding: 0; box-sizing: border-box; }

      /* ── Selection ─────────────────────────────────────── */
      ::selection { background: rgba(217, 79, 61, 0.3); }

      /* ── Base ─────────────────────────────────────────── */
      html { font-size: 17px; }

      body {
        font-family: var(--body);
        font-weight: 300;
        background: var(--bg);
        color: var(--fg);
        line-height: 1.8;
        padding: 2.5rem 2rem 6rem;
        max-width: 860px;
        margin: 0 auto;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      /* CRT scanline overlay — subtle horizontal lines across entire viewport */
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        background: repeating-linear-gradient(
          0deg,
          transparent,
          transparent 2px,
          rgba(0, 0, 0, 0.03) 2px,
          rgba(0, 0, 0, 0.03) 4px
        );
        pointer-events: none;
        z-index: 9999;
      }

      a { color: inherit; text-decoration: none; transition: color 0.15s; }
      a:hover { color: var(--red); }

      /* ── Site header ──────────────────────────────────── */
      .site-header {
        margin-bottom: 3rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--line);
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
      }
      .site-header .logo {
        font-family: var(--mono);
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--fg);
      }
      .site-header .logo::before {
        content: "// ";
        color: var(--red);
      }
      .site-header .logo:hover { color: var(--red); }
      .site-header nav {
        display: flex;
        gap: 1.2rem;
        font-family: var(--mono);
        font-size: 0.55rem;
        text-transform: uppercase;
        letter-spacing: 0.15em;
      }
      .site-header nav a { color: var(--fg3); }
      .site-header nav a:hover { color: var(--fg); }

      main { flex: 1; }

      /* ── Headings ─────────────────────────────────────── */
      h1 {
        font-family: var(--cond);
        font-size: clamp(1.8rem, 4vw, 2.5rem);
        font-weight: 800;
        line-height: 1.05;
        letter-spacing: -0.02em;
        margin-bottom: 0.5rem;
        text-transform: uppercase;
      }
      h1 .hl { color: var(--red); }

      .hero {
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--line);
      }
      .hero-text {
        font-weight: 300;
        color: var(--fg2);
        font-size: 0.9rem;
        margin-bottom: 1rem;
        line-height: 1.6;
      }

      /* ── Social link pills ────────────────────────────── */
      .social-links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.4rem;
      }
      .social-links a {
        font-family: var(--mono);
        font-size: 0.6rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--fg3);
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-color: var(--red-dim);
        text-decoration-thickness: 1px;
        transition: color 0.15s, text-decoration-color 0.15s;
      }
      .social-links a:hover {
        color: var(--red);
        text-decoration-color: var(--red);
      }
      .social-sep {
        color: var(--line);
        font-size: 0.5rem;
      }

      .home-footer {
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--line);
        font-size: 0.85rem;
        color: var(--fg2);
        line-height: 1.6;
      }
      .home-footer p {
        font-weight: 300;
        margin-bottom: 0.8rem;
      }

      .page-desc {
        font-weight: 300;
        color: var(--fg2);
        font-size: 0.9rem;
        margin-bottom: 2rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--line);
      }

      h2 {
        font-family: var(--cond);
        font-size: 1.3rem;
        font-weight: 700;
        margin-top: 2.5rem;
        letter-spacing: -0.01em;
      }
      h2::before {
        content: "// ";
        color: var(--red);
        font-weight: 600;
      }
      h3 {
        font-family: var(--cond);
        font-size: 1.05rem;
        font-weight: 600;
        margin-top: 2rem;
      }
      p, li { margin-bottom: 1rem; }
      ul, ol { padding-left: 1.2rem; }

      /* ── Code blocks & inline code ────────────────────── */
      code {
        font-family: var(--mono);
        font-size: 0.75rem;
        background: var(--bg1);
        padding: 0.15em 0.45em;
        border-radius: 3px;
        color: var(--red);
        border: 1px solid var(--line);
      }
      pre {
        background: var(--bg1);
        padding: 1.2rem;
        border-radius: 4px;
        overflow-x: auto;
        margin-bottom: 1.2rem;
        border: 1px solid var(--line);
        border-left: 3px solid var(--red);
      }
      pre code { background: none; padding: 0; border: none; border-radius: 0; color: var(--fg); }

      img {
        max-width: 100%;
        height: auto;
        border-radius: 4px;
        border: 1px solid var(--line);
      }

      blockquote {
        border-left: 3px solid var(--red-dim);
        padding: 0.8rem 0 0.8rem 1.2rem;
        color: var(--fg2);
        margin: 1.5rem 0;
        background: var(--red-bg);
        border-radius: 0 4px 4px 0;
      }

      hr {
        border: none;
        height: 1px;
        background: var(--line);
        margin: 3rem 0;
      }

      /* ── Post list (reused on home + /posts/) ────────── */

      /* Target each li so JS can toggle .hidden-more / .hidden-filtered */
      .post-list { list-style: none; padding: 0; }
      .post-list li {
        margin-bottom: 2px;
        padding: 1.2rem 1.5rem;
        background: var(--bg1);
        border: 1px solid var(--line);
        border-radius: 0;
        transition: border-color 0.15s, background 0.15s;
      }
      .post-list li:hover {
        border-color: var(--fg3);
        background: var(--bg);
      }
      .post-list time {
        font-family: var(--mono);
        font-size: 0.6rem;
        color: var(--fg3);
        display: block;
        margin-bottom: 0.2rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
      }
      .post-list .post-title {
        font-family: var(--cond);
        font-size: clamp(1rem, 2.5vw, 1.25rem);
        font-weight: 700;
        line-height: 1.2;
        color: var(--fg);
      }
      .post-list .post-title:hover { color: var(--red); }
      .post-list .post-excerpt {
        font-family: var(--body);
        font-weight: 300;
        font-size: 0.8rem;
        color: var(--fg2);
        margin-top: 0.3rem;
      }

      /* ── Post meta (date + tags on individual post page) ─ */
      .post-meta {
        font-family: var(--mono);
        font-size: 0.6rem;
        color: var(--fg3);
        margin-bottom: 2rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--line);
      }
      .post-meta .sep {
        display: inline-block;
        margin: 0 0.5rem;
        color: var(--line);
      }

      /* ── Search bar & tag filter buttons ──────────────── */
      .search-bar {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
        margin-bottom: 1.5rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--line);
      }
      .search-input {
        font-family: var(--mono);
        font-size: 0.8rem;
        padding: 0.5rem 0.8rem;
        background: var(--bg1);
        border: 1px solid var(--line);
        border-radius: 2px;
        color: var(--fg);
        outline: none;
        transition: border-color 0.15s;
      }
      .search-input:focus {
        border-color: var(--red-dim);
      }
      .search-input::placeholder {
        color: var(--fg3);
      }
      .tag-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
      }
      .tag-filter {
        font-family: var(--mono);
        font-size: 0.5rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 0.2rem 0.45rem;
        border: 1px solid var(--line);
        border-radius: 2px;
        color: var(--fg3);
        background: transparent;
        cursor: pointer;
        transition: border-color 0.15s, color 0.15s, background 0.15s;
        line-height: 1.2;
      }
      .tag-filter:hover {
        border-color: var(--red-dim);
        color: var(--red);
      }
      .tag-filter.active {
        border-color: var(--red);
        color: var(--red);
        background: var(--red-bg);
      }

      /* ── Tags on each post card (red border pills) ───── */
      .tags-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
        list-style: none;
        padding: 0;
        margin-top: 0.4rem;
      }
      .tags-list li { margin: 0; }
      .tag {
        display: inline-block;
        font-family: var(--mono);
        font-size: 0.55rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.1rem 0.35rem;
        border: 1px solid var(--red-dim);
        border-radius: 2px;
        color: var(--red);
        line-height: 1.2;
        cursor: pointer;
        transition: background 0.15s;
      }
      .tag:hover {
        background: var(--red-bg);
      }

      /* ── Visibility toggles for JS ─────────────────────
         .hidden        — generic hidden (reserved)
         .hidden-filtered — hidden by search/tag filter
         .hidden-more   — hidden by "show more" limit (home only)
      */
      .post-list li.hidden,
      .post-list li.hidden-filtered {
        display: none;
      }
      .post-list li.hidden-more {
        display: none;
      }

      /* ── "Ver más posts" button (home only) ──────────── */
      .btn-show-more {
        display: block;
        width: 100%;
        margin-top: 0.5rem;
        padding: 0.7rem;
        font-family: var(--mono);
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: var(--fg3);
        background: var(--bg1);
        border: 1px solid var(--line);
        cursor: pointer;
        transition: border-color 0.15s, color 0.15s;
      }
      .btn-show-more:hover {
        border-color: var(--red-dim);
        color: var(--red);
      }
      .btn-show-more.hidden {
        display: none;
      }

      /* ── Post footer (individual post page) ──────────── */
      .post-footer {
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--line);
        font-family: var(--mono);
        font-size: 0.7rem;
      }
      .post-footer a { color: var(--red); }
      .post-footer a:hover { text-decoration: underline; }

      /* ── Site footer (copyright) ──────────────────────── */
      footer {
        margin-top: 4rem;
        padding-top: 1.5rem;
        border-top: 1px solid var(--line);
        font-family: var(--mono);
        font-size: 0.55rem;
        color: var(--fg3);
        text-align: center;
        text-transform: uppercase;
        letter-spacing: 0.15em;
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="logo">{SITE.name}</a>
      <nav>
        <a href="/">Inicio</a>
        <a href="/posts/">Posts</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      &copy; {new Date().getFullYear()} {SITE.author} &mdash; {SITE.name}
    </footer>
  </body>
</html>
