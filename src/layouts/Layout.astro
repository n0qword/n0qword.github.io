---
import { frontmatter as SITE } from "../data/home.md";

export interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const siteName = SITE.name;
const year = String(new Date().getFullYear());
const siteUrl = Astro.site?.href.replace(/\/$/, "") ?? "https://blog.n0qword.com";
const ogUrl = siteUrl + Astro.url.pathname;
const ogImage = image ? (image.startsWith("http") ? image : siteUrl + image) : "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description ?? title} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? title} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="application-name" content={SITE.name} />
    <meta property="og:url" content={ogUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description ?? title} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" media="(prefers-color-scheme: light)" href="/icons/iceking-light.png" />
    <link rel="icon" type="image/png" media="(prefers-color-scheme: dark)" href="/icons/iceking-dark.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <script is:inline>
      (function () {
        var t = localStorage.getItem("theme");
        if (t !== "light" && t !== "dark") {
          t = window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        }
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="preload" as="style" />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" />
    </noscript>

    <style is:global>
      :root {
        --mono: "IBM Plex Mono", monospace;
        --body: "IBM Plex Sans", system-ui, sans-serif;
        --display: "Bricolage Grotesque", "IBM Plex Sans", system-ui, sans-serif;
      }

      :root, :root[data-theme="dark"] {
        --bg: #0b0b0d;
        --bg1: #131316;
        --bg2: #1a1a1e;
        --line: #2a2a2f;
        --fg: #f2f2f2;
        --fg2: #a0a0a6;
        --fg3: #6b6b72;
        --accent: #ededed;
        --accent-dim: #8a8a90;
        --accent-bg: #1f1f23;
        --title: #f5f5f5;
        --accent2: #cfcfd4;
        --accent2-dim: #9a9aa1;
        --accent2-bg: #1c1c20;
      }

      :root[data-theme="light"] {
        --bg: #fafafa;
        --bg1: #f2f2f2;
        --bg2: #e8e8e8;
        --line: #dcdcdc;
        --fg: #111112;
        --fg2: #55555c;
        --fg3: #8a8a90;
        --accent: #111112;
        --accent-dim: #55555c;
        --accent-bg: #ececec;
        --title: #111112;
        --accent2: #55555c;
        --accent2-dim: #8a8a90;
        --accent2-bg: #efefef;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }
      ::selection { background: color-mix(in srgb, var(--fg) 20%, transparent); }

      html { font-size: 16px; }

      body {
        font-family: var(--body);
        font-weight: 400;
        background: var(--bg);
        color: var(--fg);
        line-height: 1.75;
        padding: 2.5rem 1.5rem 5rem;
        max-width: 820px;
        margin: 0 auto;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      a { color: var(--accent); text-decoration: none; }
      a:hover { color: var(--title); text-decoration: underline; }

      article a {
        text-decoration: underline;
        text-decoration-color: var(--fg3);
        text-underline-offset: 3px;
      }
      article a:hover { text-decoration-color: var(--fg); }

      .site-header {
        margin-bottom: 2.5rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid var(--line);
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .site-brand {
        display: flex;
        align-items: center;
      }
      .brand-ico {
        height: 72px;
        width: auto;
        border: none;
        border-radius: 0;
        display: block;
      }
      .brand-ico.ico-light { display: none; }
      :root[data-theme="light"] .brand-ico.ico-dark { display: none; }
      :root[data-theme="light"] .brand-ico.ico-light { display: block; }

      .site-header nav {
        display: flex;
        align-items: center;
        gap: 1.5rem;
      }
      .site-header nav a {
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--fg2);
        transition: color 0.15s;
      }
      .site-header nav a:hover { color: var(--fg); }

      .theme-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.2rem 0.4rem;
        background: transparent;
        border: 1px solid var(--line);
        border-radius: 6px;
        color: var(--fg2);
        font-size: 0.86rem;
        line-height: 1;
        cursor: pointer;
        transition: border-color 0.15s, color 0.15s;
      }
      .theme-toggle:hover {
        border-color: var(--accent-dim);
        color: var(--accent);
      }
      .theme-toggle .t-dark { display: inline; }
      .theme-toggle .t-light { display: none; }
      :root[data-theme="light"] .theme-toggle .t-dark { display: none; }
      :root[data-theme="light"] .theme-toggle .t-light { display: inline; }

      main { flex: 1; }

      h1, h2, h3 {
        font-family: var(--display);
        font-weight: 600;
      }

      h1 {
        font-size: clamp(1.85rem, 5vw, 2.5rem);
        line-height: 1.16;
        margin-bottom: 0.5rem;
        letter-spacing: -0.015em;
        color: var(--title);
      }

      h2 {
        font-size: 1.4rem;
        line-height: 1.3;
        margin-top: 2.5rem;
        margin-bottom: 0.7rem;
        letter-spacing: -0.005em;
        color: var(--title);
      }
      h3 {
        font-size: 1.08rem;
        line-height: 1.35;
        margin-top: 2rem;
        margin-bottom: 0.5rem;
        letter-spacing: 0;
        color: var(--fg);
      }
      p, li { margin-bottom: 0.8rem; }
      ul, ol { padding-left: 1.2rem; }

      code {
        font-family: var(--mono);
        font-size: 0.85em;
        background: var(--bg2);
        padding: 0.15em 0.4em;
        border-radius: 4px;
        color: var(--accent);
      }
      pre {
        background: var(--bg1);
        padding: 1.1rem 1.2rem;
        border-radius: 8px;
        overflow-x: auto;
        margin-bottom: 1.2rem;
        border: 1px solid var(--line);
        font-size: 0.92em;
        line-height: 1.7;
      }
      pre code { background: none; padding: 0; border-radius: 0; }

      .astro-code {
        background: var(--bg1) !important;
      }
      .astro-code,
      .astro-code span {
        color: var(--shiki-light);
      }
      :root[data-theme="dark"] .astro-code,
      :root[data-theme="dark"] .astro-code span {
        color: var(--shiki-dark);
      }

      img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        border: 1px solid var(--line);
      }

      blockquote {
        border-left: 3px solid var(--accent-dim);
        padding: 0.6rem 0 0.6rem 1rem;
        color: var(--fg2);
        margin: 1.2rem 0;
      }

      hr {
        border: none;
        height: 1px;
        background: var(--line);
        margin: 2.5rem 0;
      }

      .youtube-embed {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        margin-block: 2rem;
        overflow: hidden;
        background: var(--bg1);
        border: 1px solid var(--line);
        border-radius: 8px;
      }

      .youtube-embed iframe {
        display: block;
        width: 100%;
        height: 100%;
        border: 0;
      }

      @media (max-width: 560px) {
        .youtube-embed {
          margin-block: 1.75rem;
          border-radius: 10px;
        }
      }

      .page-desc {
        color: var(--fg2);
        font-size: 1rem;
        margin-bottom: 1.5rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid var(--line);
      }
      .page-desc .count {
        font-family: var(--mono);
        font-size: 0.82rem;
        color: var(--accent);
      }

      .post-list {
        list-style: none;
        padding: 0;
      }
      .post-list li {
        margin: 0;
        padding: 1rem 0;
        border-bottom: 1px solid var(--line);
      }
      .post-list li:first-child {
        padding-top: 0;
      }
      .post-list li.hidden-filtered,
      .post-list li.hidden-more {
        display: none;
      }

      .post-item {
        display: block;
        color: inherit;
      }
      .post-item:hover { color: inherit; text-decoration: none; }

      .post-item-title {
        display: block;
        font-family: var(--display);
        font-weight: 600;
        font-size: 1.34rem;
        line-height: 1.25;
        margin-bottom: 0.4rem;
        letter-spacing: 0.005em;
        color: var(--title);
        text-decoration: none;
        transition: color 0.15s;
      }
      .post-item-title:hover { color: #c9c9cf; text-decoration: none; }
      .post-item-title:focus-visible {
        outline: 2px solid var(--accent2);
        outline-offset: 3px;
        border-radius: 4px;
      }

      .post-item-excerpt {
        font-size: 0.95rem;
        color: var(--fg2);
        line-height: 1.65;
        margin-bottom: 0.45rem;
      }

      .post-item-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        font-family: var(--mono);
        font-size: 0.78rem;
        color: var(--fg3);
      }

      .post-item-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
      }

      .post-item-taglist {
        font-family: var(--mono);
        font-size: 0.72rem;
        color: var(--fg2);
        text-transform: lowercase;
      }

      .tag {
        display: inline-block;
        padding: 0.12rem 0.4rem;
        font-family: var(--mono);
        font-size: 0.68rem;
        font-weight: 400;
        text-transform: lowercase;
        letter-spacing: 0.02em;
        border: 1px solid var(--line);
        border-radius: 2px;
        color: var(--fg2);
        background: transparent;
        cursor: pointer;
        transition: border-color 0.15s, color 0.15s;
      }
      .tag:hover {
        border-color: var(--fg3);
        color: var(--fg);
      }

      .post-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        font-family: var(--mono);
        font-size: 0.78rem;
        color: var(--fg3);
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--line);
      }
      .post-meta .sep { color: var(--line); }

      .tags-list {
        display: inline-flex;
        flex-wrap: wrap;
        gap: 0.3rem;
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .tags-list li { margin: 0; }

      .filters-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin-bottom: 1.25rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid var(--line);
      }

      .social-links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.9rem;
      }
      .social-links a {
        color: var(--fg2);
        transition: color 0.15s;
      }
      .social-links a:hover { color: var(--accent); }
      .social-sep { color: var(--line); font-size: 0.75rem; }

      .tag-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
      }
      .tag-filter {
        font-family: var(--mono);
        font-size: 0.72rem;
        text-transform: lowercase;
        padding: 0.2rem 0.5rem;
        border: 1px solid var(--line);
        border-radius: 3px;
        color: var(--fg3);
        background: transparent;
        cursor: pointer;
        transition: border-color 0.15s, color 0.15s, background 0.15s;
      }
      .tag-filter:hover {
        border-color: color-mix(in srgb, var(--accent2) 55%, transparent);
        color: var(--accent2);
      }
      .tag-filter.active {
        border-color: var(--accent2);
        color: var(--accent2);
        background: var(--accent2-bg);
      }

      .btn-show-more {
        display: block;
        width: 100%;
        margin-top: 0.5rem;
        padding: 0.7rem;
        font-family: var(--mono);
        font-size: 0.78rem;
        color: var(--fg3);
        background: transparent;
        border: 1px solid var(--line);
        border-radius: 6px;
        cursor: pointer;
        transition: border-color 0.15s, color 0.15s;
      }
      .btn-show-more:hover {
        border-color: var(--accent-dim);
        color: var(--accent);
      }
      .btn-show-more.hidden { display: none; }

      .post-cover {
        display: block;
        width: 100%;
        margin: 0 0 1.5rem;
        aspect-ratio: 21 / 9;
        object-fit: cover;
        border-radius: 8px;
      }

      .post-footer {
        margin-top: 2.5rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--line);
        font-family: var(--mono);
        font-size: 0.82rem;
      }
      .post-footer a { color: var(--accent); }
      .post-footer a:hover { text-decoration: underline; }

      footer.pg-footer {
        margin-top: 4rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--line);
        font-family: var(--mono);
        font-size: 0.78rem;
        color: var(--fg3);
        text-align: center;
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <a class="site-brand" href="/" aria-label="home">
        <img class="brand-ico ico-dark" src="/icons/iceking-dark.png" alt="" />
        <img class="brand-ico ico-light" src="/icons/iceking-light.png" alt="" />
      </a>
      <nav>
        <a href="/posts/">posts</a>
        <a href="/notes/">notes</a>
        <a href="/talks/">talks</a>
        <a href="/about/">about</a>
        <button class="theme-toggle" id="theme-toggle" aria-label="Toggle color theme">
          <span class="t-dark" aria-hidden="true">☾</span>
          <span class="t-light" aria-hidden="true">☀</span>
        </button>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="pg-footer">
      © {year} {SITE.author} — {siteName}
    </footer>
    <script is:inline>
      (function () {
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;
        btn.addEventListener("click", function () {
          var cur = document.documentElement.getAttribute("data-theme") === "light" ? "light" : "dark";
          var next = cur === "light" ? "dark" : "light";
          document.documentElement.setAttribute("data-theme", next);
          try { localStorage.setItem("theme", next); } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
