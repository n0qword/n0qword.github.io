---
import { frontmatter as SITE } from "../data/home.md";

export interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const siteName = SITE.name;
const year = String(new Date().getFullYear());
const siteUrl = Astro.site?.href.replace(/\/$/, "") ?? "https://blog.n0qword.com";
const ogUrl = siteUrl + Astro.url.pathname;
const ogImage = image ? (image.startsWith("http") ? image : siteUrl + image) : "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description ?? title} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? title} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="application-name" content={SITE.name} />
    <meta property="og:url" content={ogUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description ?? title} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" media="(prefers-color-scheme: light)" href="/icons/iceking-light.png" />
    <link rel="icon" type="image/png" media="(prefers-color-scheme: dark)" href="/icons/iceking-dark.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <script is:inline>
      (function () {
        var t = localStorage.getItem("theme");
        if (t !== "light" && t !== "dark") {
          t = window.matchMedia && window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
        }
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="preload" as="style" />
    <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" />
    </noscript>

    <style is:global>
      :root {
        --mono: "JetBrains Mono", monospace;
        --body: "Inter", system-ui, sans-serif;
        --display: "Chakra Petch", "Inter", system-ui, sans-serif;
        --radius: 12px;
      }

      :root, :root[data-theme="dark"] {
        --bg: #100d18;
        --bg1: #171320;
        --bg2: #1e1929;
        --line: #2c2539;
        --fg: #ebe7f4;
        --fg2: #a79fbc;
        --fg3: #6f6786;
        --blue: #34d399;
        --blue-dim: #10b981;
        --blue-bg: #10241f;
        --title: #5eead4;
        --violet: #a78bfa;
        --violet-dim: #8b5cf6;
        --violet-bg: #201637;
        --glow-1: rgba(45, 212, 191, 0.11);
        --glow-2: rgba(139, 92, 246, 0.16);
      }

      :root[data-theme="light"] {
        --bg: #f7f9fa;
        --bg1: #eef1f4;
        --bg2: #e1e6eb;
        --line: #d2d9e2;
        --fg: #101820;
        --fg2: #46525f;
        --fg3: #8894a3;
        --blue: #0f9d76;
        --blue-dim: #0b7a5c;
        --blue-bg: #d9f5ec;
        --title: #0f766e;
        --violet: #7c3aed;
        --violet-dim: #6d28d9;
        --violet-bg: #ece7fe;
        --glow-1: rgba(16, 185, 129, 0.10);
        --glow-2: rgba(124, 58, 237, 0.07);
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }
      ::selection { background: rgba(45, 212, 191, 0.28); }

      html { font-size: 16px; }

      body {
        font-family: var(--body);
        font-weight: 400;
        background-color: var(--bg);
        background-image:
          radial-gradient(900px 520px at 12% -8%, var(--glow-1), transparent 60%),
          radial-gradient(760px 460px at 92% 4%, var(--glow-2), transparent 62%),
          radial-gradient(620px 420px at 50% 108%, var(--glow-1), transparent 65%);
        background-attachment: fixed;
        color: var(--fg);
        line-height: 1.75;
        padding: 2.5rem 1.5rem 5rem;
        max-width: 860px;
        margin: 0 auto;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      a { color: var(--blue); text-decoration: none; }
      a:hover { color: var(--title); text-decoration: underline; }

      .site-header {
        margin-bottom: 2.5rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid var(--line);
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .site-brand {
        display: flex;
        align-items: center;
      }
      .brand-ico {
        height: 72px;
        width: auto;
        border: none;
        border-radius: 0;
        display: block;
      }
      .brand-ico.ico-light { display: none; }
      :root[data-theme="light"] .brand-ico.ico-dark { display: none; }
      :root[data-theme="light"] .brand-ico.ico-light { display: block; }

      .site-header nav {
        display: flex;
        align-items: center;
        gap: 1.5rem;
      }
      .site-header nav a {
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--fg2);
        transition: color 0.15s;
      }
      .site-header nav a:hover { color: var(--fg); }

      .theme-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.2rem 0.4rem;
        background: transparent;
        border: 1px solid var(--line);
        border-radius: 6px;
        color: var(--fg2);
        font-size: 0.86rem;
        line-height: 1;
        cursor: pointer;
        transition: border-color 0.15s, color 0.15s;
      }
      .theme-toggle:hover {
        border-color: var(--blue-dim);
        color: var(--blue);
      }
      .theme-toggle .t-dark { display: inline; }
      .theme-toggle .t-light { display: none; }
      :root[data-theme="light"] .theme-toggle .t-dark { display: none; }
      :root[data-theme="light"] .theme-toggle .t-light { display: inline; }

      main { flex: 1; }

      h1, h2, h3 {
        font-family: var(--display);
        font-weight: 600;
      }

      h1 {
        font-size: clamp(1.85rem, 5vw, 2.6rem);
        line-height: 1.14;
        margin-bottom: 0.5rem;
        letter-spacing: -0.01em;
        color: var(--title);
        background: linear-gradient(96deg, var(--title) 0%, var(--violet) 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        filter: drop-shadow(0 0 26px color-mix(in srgb, var(--title) 22%, transparent));
      }

      h2 {
        font-size: 1.45rem;
        line-height: 1.28;
        margin-top: 2.75rem;
        margin-bottom: 0.7rem;
        letter-spacing: 0.005em;
        color: var(--title);
        padding-bottom: 0.45rem;
        border-bottom: 1px solid color-mix(in srgb, var(--title) 22%, transparent);
      }
      h3 {
        font-size: 1.1rem;
        line-height: 1.35;
        margin-top: 2.1rem;
        margin-bottom: 0.5rem;
        letter-spacing: 0.01em;
        color: var(--title);
        opacity: 0.92;
      }
      p, li { margin-bottom: 0.8rem; }
      ul, ol { padding-left: 1.2rem; }

      code {
        font-family: var(--mono);
        font-size: 0.85em;
        background: var(--bg2);
        padding: 0.15em 0.4em;
        border-radius: 4px;
        color: var(--blue);
      }
      pre {
        background: var(--bg1);
        padding: 1.1rem 1.2rem;
        border-radius: 8px;
        overflow-x: auto;
        margin-bottom: 1.2rem;
        border: 1px solid var(--line);
        font-size: 0.92em;
        line-height: 1.7;
      }
      pre code { background: none; padding: 0; border-radius: 0; }

      .astro-code {
        background: var(--bg1) !important;
      }
      .astro-code,
      .astro-code span {
        color: var(--shiki-light);
      }
      :root[data-theme="dark"] .astro-code,
      :root[data-theme="dark"] .astro-code span {
        color: var(--shiki-dark);
      }

      img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        border: 1px solid var(--line);
      }

      blockquote {
        border-left: 3px solid var(--blue-dim);
        padding: 0.6rem 0 0.6rem 1rem;
        color: var(--fg2);
        margin: 1.2rem 0;
      }

      hr {
        border: none;
        height: 1px;
        background: var(--line);
        margin: 2.5rem 0;
      }

      .youtube-embed {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        margin-block: 2.25rem;
        overflow: hidden;
        background: var(--bg1);
        border-radius: 14px;
        box-shadow:
          0 0 0 1px color-mix(in srgb, var(--line) 45%, transparent),
          0 0 24px color-mix(in srgb, var(--blue-dim) 16%, transparent),
          0 16px 56px rgba(0, 0, 0, 0.3);
      }

      .youtube-embed iframe {
        display: block;
        width: 100%;
        height: 100%;
        border: 0;
      }

      @media (max-width: 560px) {
        .youtube-embed {
          margin-block: 1.75rem;
          border-radius: 10px;
        }
      }

      .page-desc {
        color: var(--fg2);
        font-size: 1rem;
        margin-bottom: 1.5rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid var(--line);
      }
      .page-desc .count {
        font-family: var(--mono);
        font-size: 0.82rem;
        color: var(--blue);
      }

      .post-list {
        list-style: none;
        padding: 0;
      }
      .post-list li {
        margin: 0;
        padding: 1rem 0;
        border-bottom: 1px solid var(--line);
      }
      .post-list li:first-child {
        padding-top: 0;
      }
      .post-list li.hidden-filtered,
      .post-list li.hidden-more {
        display: none;
      }

      .post-item {
        display: block;
        color: inherit;
      }
      .post-item:hover { color: inherit; text-decoration: none; }

      .post-item-media {
        display: flex;
        align-items: flex-start;
        gap: 1.5rem;
      }
      .post-item-media .post-item-body {
        flex: 1;
        min-width: 0;
      }
      .post-item-thumb {
        flex: 0 0 auto;
        width: 188px;
        height: 106px;
        object-fit: cover;
        border-radius: var(--radius);
        border: 1px solid var(--line);
        background: var(--bg1);
        pointer-events: none;
        user-select: none;
      }
      @media (max-width: 620px) {
        .post-item-media { gap: 1rem; }
        .post-item-thumb { width: 104px; height: 60px; border-radius: 9px; }
      }

      .post-item-title {
        display: block;
        font-family: var(--display);
        font-weight: 600;
        font-size: 1.34rem;
        line-height: 1.25;
        margin-bottom: 0.4rem;
        letter-spacing: 0.005em;
        color: var(--title);
        text-decoration: none;
        transition: color 0.15s;
      }
      .post-item-title:hover { color: var(--violet); text-decoration: none; }
      .post-item-title:focus-visible {
        outline: 2px solid var(--violet);
        outline-offset: 3px;
        border-radius: 4px;
      }

      .post-item-excerpt {
        font-size: 0.95rem;
        color: var(--fg2);
        line-height: 1.65;
        margin-bottom: 0.45rem;
      }

      .post-item-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        font-family: var(--mono);
        font-size: 0.78rem;
        color: var(--fg3);
      }

      .post-item-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
      }

      .tag {
        display: inline-block;
        padding: 0.15rem 0.5rem;
        font-family: var(--mono);
        font-size: 0.72rem;
        font-weight: 500;
        text-transform: lowercase;
        border: 1px solid color-mix(in srgb, var(--violet) 45%, transparent);
        border-radius: 999px;
        color: var(--violet);
        background: color-mix(in srgb, var(--violet) 8%, transparent);
        cursor: pointer;
        transition: background 0.15s, border-color 0.15s, color 0.15s;
      }
      .tag:hover {
        background: var(--violet-bg);
        border-color: var(--violet);
        color: var(--violet);
      }

      .post-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        font-family: var(--mono);
        font-size: 0.78rem;
        color: var(--fg3);
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--line);
      }
      .post-meta .sep { color: var(--line); }

      .tags-list {
        display: inline-flex;
        flex-wrap: wrap;
        gap: 0.3rem;
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .tags-list li { margin: 0; }

      .search-bar {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        margin-bottom: 1.25rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid var(--line);
      }
      .search-input {
        font-family: var(--mono);
        font-size: 0.88rem;
        padding: 0.5rem 0.75rem;
        background: var(--bg1);
        border: 1px solid var(--line);
        border-radius: 6px;
        color: var(--fg);
        outline: none;
        transition: border-color 0.15s;
      }
      .search-input:focus {
        border-color: var(--blue-dim);
      }
      .search-input::placeholder { color: var(--fg3); }

      .social-links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.9rem;
      }
      .social-links a {
        color: var(--fg2);
        transition: color 0.15s;
      }
      .social-links a:hover { color: var(--blue); }
      .social-sep { color: var(--line); font-size: 0.75rem; }

      .tag-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 0.3rem;
      }
      .tag-filter {
        font-family: var(--mono);
        font-size: 0.72rem;
        text-transform: lowercase;
        padding: 0.2rem 0.5rem;
        border: 1px solid var(--line);
        border-radius: 3px;
        color: var(--fg3);
        background: transparent;
        cursor: pointer;
        transition: border-color 0.15s, color 0.15s, background 0.15s;
      }
      .tag-filter:hover {
        border-color: color-mix(in srgb, var(--violet) 55%, transparent);
        color: var(--violet);
      }
      .tag-filter.active {
        border-color: var(--violet);
        color: var(--violet);
        background: var(--violet-bg);
      }

      .btn-show-more {
        display: block;
        width: 100%;
        margin-top: 0.5rem;
        padding: 0.7rem;
        font-family: var(--mono);
        font-size: 0.78rem;
        color: var(--fg3);
        background: transparent;
        border: 1px solid var(--line);
        border-radius: 6px;
        cursor: pointer;
        transition: border-color 0.15s, color 0.15s;
      }
      .btn-show-more:hover {
        border-color: var(--blue-dim);
        color: var(--blue);
      }
      .btn-show-more.hidden { display: none; }

      .post-cover {
        display: block;
        width: 100%;
        margin: 0 0 1.5rem;
        aspect-ratio: 21 / 9;
        object-fit: cover;
        border-radius: 8px;
      }

      .post-footer {
        margin-top: 2.5rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--line);
        font-family: var(--mono);
        font-size: 0.82rem;
      }
      .post-footer a { color: var(--blue); }
      .post-footer a:hover { text-decoration: underline; }

      footer.pg-footer {
        margin-top: 4rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--line);
        font-family: var(--mono);
        font-size: 0.78rem;
        color: var(--fg3);
        text-align: center;
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <a class="site-brand" href="/" aria-label="home">
        <img class="brand-ico ico-dark" src="/icons/iceking-dark.png" alt="" />
        <img class="brand-ico ico-light" src="/icons/iceking-light.png" alt="" />
      </a>
      <nav>
        <a href="/posts/">posts</a>
        <a href="/notes/">notes</a>
        <a href="/talks/">talks</a>
        <a href="/about/">about</a>
        <button class="theme-toggle" id="theme-toggle" aria-label="Toggle color theme">
          <span class="t-dark" aria-hidden="true">☾</span>
          <span class="t-light" aria-hidden="true">☀</span>
        </button>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="pg-footer">
      © {year} {SITE.author} — {siteName}
    </footer>
    <script is:inline>
      (function () {
        var btn = document.getElementById("theme-toggle");
        if (!btn) return;
        btn.addEventListener("click", function () {
          var cur = document.documentElement.getAttribute("data-theme") === "light" ? "light" : "dark";
          var next = cur === "light" ? "dark" : "light";
          document.documentElement.setAttribute("data-theme", next);
          try { localStorage.setItem("theme", next); } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
