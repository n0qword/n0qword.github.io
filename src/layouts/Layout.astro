---
import { frontmatter as SITE } from "../data/home.md";

export interface Props {
  title: string;
  description?: string;
  image?: string;
  centered?: boolean;
}

const { title, description, image, centered = false } = Astro.props;
const year = String(new Date().getFullYear());
const siteUrl = Astro.site?.href.replace(/\/$/, "") ?? "https://blog.n0qword.com";
const ogUrl = siteUrl + Astro.url.pathname;
const ogImage = image ? (image.startsWith("http") ? image : siteUrl + image) : "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description ?? title} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? title} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="application-name" content={SITE.name} />
    <meta property="og:url" content={ogUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description ?? title} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/icons/iceking-dark.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <style is:global>
      :root {
        --bg: #181824;
        --bg1: #1e1e2c;
        --text: #f2f2f2;
        --heading: #ffffff;
        --link: #8b9cf7;
        --link-hover: #a78bfa;
        --muted: #a8a8b8;
        --border: #32324a;
        --border-strong: #4a4a66;
        --nav: #a8a8b8;
        --nav-hover: #ffffff;
        --code-bg: #1e1e2c;

        /* aliases kept for page-level styles */
        --fg2: var(--text);
        --fg3: var(--muted);
        --line: var(--border);
        --blue: var(--link);
        --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }
      ::selection { background: rgba(139, 156, 247, 0.3); }

      html { font-size: 16px; }

      body {
        background: var(--bg);
        color: var(--text);
        font-family: var(--sans);
        font-size: 1rem;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      a { color: var(--link); text-decoration: none; }
      a:hover { color: var(--link-hover); }

      img { max-width: 100%; height: auto; }

      /* masthead */
      .masthead {
        border-bottom: 1px solid var(--border);
        background: var(--bg);
      }
      .masthead__inner {
        max-width: 1120px;
        margin: 0 auto;
        padding: 1rem 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
      }
      .site-title {
        font-weight: 700;
        font-size: 1.05rem;
        letter-spacing: -0.01em;
        color: var(--heading);
      }
      .site-title:hover { color: var(--heading); }
      .site-nav {
        display: flex;
        align-items: center;
        gap: 1.5rem;
      }
      .site-nav a {
        position: relative;
        display: block;
        padding: 0.3rem 0;
        font-size: 1.05rem;
        font-weight: 600;
        text-transform: lowercase;
        color: var(--nav);
      }
      .site-nav a { transition: color 0.15s; }
      .site-nav a:hover { color: var(--nav-hover); }

      /* layout */
      .wrap {
        width: 100%;
        max-width: 1120px;
        margin: 0 auto;
        padding: 2rem 1.5rem 4rem;
        flex: 1;
      }
      .layout {
        display: grid;
        grid-template-columns: 240px minmax(0, 1fr);
        gap: 3rem;
        align-items: start;
      }
      .sidebar { position: sticky; top: 2rem; }
      .layout--centered {
        display: block;
        max-width: 760px;
        margin: 0 auto;
      }

      /* author */
      .author__avatar {
        display: block;
        width: 160px;
        height: 160px;
        border-radius: 50%;
        object-fit: cover;
        border: 1px solid var(--border);
        margin-bottom: 1rem;
        background: var(--bg);
      }
      .author__name {
        font-size: 1.1rem;
        color: var(--heading);
        margin-bottom: 0.4rem;
      }
      .author__bio {
        font-size: 0.85rem;
        line-height: 1.6;
        color: var(--text);
        margin-bottom: 1rem;
      }
      .author__urls {
        list-style: none;
        display: flex;
        flex-direction: row;
        gap: 0.85rem;
        padding: 0;
        margin: 0;
      }
      .author__urls a {
        display: inline-flex;
        color: var(--muted);
        transition: color 0.15s;
      }
      .author__urls a:hover { color: var(--link); }
      .author__urls svg { width: 20px; height: 20px; display: block; fill: currentColor; }
      .author__handle { color: var(--muted); font-weight: 400; }

      /* typography */
      h1, h2, h3, h4 {
        color: var(--heading);
        font-weight: 700;
        line-height: 1.2;
        margin: 2em 0 0.5em;
      }
      h1 { font-size: 1.563em; margin-top: 0; }
      h2 { font-size: 1.25em; padding-bottom: 0.5em; border-bottom: 1px solid var(--border); }
      h3 { font-size: 1.125em; }
      p { margin: 0 0 1.3em; }

      code {
        font-family: var(--mono);
        font-size: 0.85em;
        background: var(--code-bg);
        padding: 0.1em 0.35em;
        border-radius: 3px;
      }
      pre {
        background: var(--code-bg);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 1rem;
        overflow-x: auto;
        margin-bottom: 1.3em;
        font-size: 0.85em;
        line-height: 1.55;
      }
      pre code { background: none; padding: 0; border-radius: 0; font-size: 1em; }

      blockquote {
        border-left: 4px solid var(--border-strong);
        padding: 0.25rem 0 0.25rem 1rem;
        color: var(--muted);
        margin: 1.3em 0;
      }

      hr {
        border: 0;
        border-top: 1px solid var(--border);
        margin: 2em 0;
      }

      ul, ol { padding-left: 1.4rem; margin-bottom: 1.3em; }
      li { margin-bottom: 0.35em; }

      /* archive / post list */
      .post-list { list-style: none; padding: 0; margin: 0; }
      .post-list li {
        margin: 0;
        padding: 1.4rem 0;
        border-bottom: 1px solid var(--border);
      }
      .post-list li:first-child { padding-top: 0; }
      .post-list li:last-child { border-bottom: 0; }
      .post-list li.hidden-filtered,
      .post-list li.hidden-more { display: none; }

      .post-item { display: block; color: inherit; }
      .post-item-title {
        display: block;
        font-size: 1.25em;
        font-weight: 700;
        line-height: 1.3;
        margin-bottom: 0.25em;
        color: var(--heading);
      }
      .post-item-title:hover { color: var(--link); text-decoration: none; }
      .post-item-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.75em;
        color: var(--muted);
        margin-bottom: 0.5em;
      }
      .post-item-excerpt {
        font-size: 0.9em;
        line-height: 1.6;
        color: var(--text);
        margin: 0;
      }
      .post-item-taglist { color: var(--muted); }
      .post-item-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }

      /* page header */
      .page-desc {
        font-size: 0.9em;
        color: var(--muted);
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border);
      }
      .page-desc .count { font-family: var(--mono); color: var(--link); }
      .page-sep {
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border);
      }

      /* tag filters */
      .filters-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
      }
      .tag-filters { display: flex; flex-wrap: wrap; gap: 0.5rem; }
      .tag-filter {
        font-family: var(--mono);
        font-size: 0.72rem;
        padding: 0.15rem 0.6rem;
        color: var(--nav);
        background: transparent;
        border: 1px solid var(--border-strong);
        border-radius: 999px;
        cursor: pointer;
        transition: color 0.15s, border-color 0.15s, background 0.15s;
      }
      .tag-filter:hover { color: var(--link); border-color: var(--link); }
      .tag-filter.active { color: #fff; background: var(--nav); border-color: var(--nav); }

      /* tags */
      .tag {
        display: inline-block;
        padding: 0.12rem 0.6rem;
        font-family: var(--mono);
        font-size: 0.7rem;
        color: var(--link);
        border: 1px solid var(--border-strong);
        border-radius: 999px;
        text-decoration: none;
        cursor: pointer;
        transition: border-color 0.15s, color 0.15s;
      }
      .tag:hover { border-color: var(--link); text-decoration: none; }
      .tags-list {
        display: inline-flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .tags-list li { margin: 0; }
      .post-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.8em;
        color: var(--muted);
        margin-bottom: 1.5rem;
      }
      .post-meta .sep { color: var(--border-strong); }

      .post-cover {
        display: block;
        width: 100%;
        aspect-ratio: 21 / 9;
        object-fit: cover;
        margin-bottom: 1.5rem;
        border-radius: 6px;
      }
      .social-links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.85rem;
      }
      .social-sep { color: var(--border-strong); }

      .post-footer {
        margin-top: 2.5rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border);
        font-size: 0.85em;
      }

      .btn-show-more {
        display: block;
        width: 100%;
        margin-top: 1rem;
        padding: 0.6rem;
        font-family: var(--mono);
        font-size: 0.8rem;
        color: var(--nav);
        background: transparent;
        border: 1px solid var(--border-strong);
        border-radius: 4px;
        cursor: pointer;
        transition: color 0.15s, border-color 0.15s;
      }
      .btn-show-more:hover { color: var(--link); border-color: var(--link); }
      .btn-show-more.hidden { display: none; }

      .youtube-embed {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        margin-block: 1.75rem;
        overflow: hidden;
        border: 1px solid var(--border);
        border-radius: 4px;
      }
      .youtube-embed iframe { display: block; width: 100%; height: 100%; border: 0; }

      /* footer */
      .page-footer {
        background: var(--border);
        color: var(--muted);
        font-size: 0.75em;
        text-align: center;
        padding: 1.5rem;
      }
      .page-footer a { color: inherit; }
      .page-footer a:hover { text-decoration: underline; }

      @media (max-width: 820px) {
        .layout { grid-template-columns: 1fr; gap: 2rem; }
        .sidebar { position: static; }
        .author__avatar {
          width: 96px;
          height: 96px;
          margin-bottom: 0.75rem;
        }
        .author__bio { margin-bottom: 0.75rem; }
        .author__urls {
          flex-direction: row;
          flex-wrap: wrap;
          gap: 0.75rem;
        }
      }

      @media (max-width: 640px) {
        .masthead__inner {
          flex-direction: column;
          align-items: flex-start;
          gap: 0.5rem;
          padding: 0.9rem 1.1rem;
        }
        .site-nav {
          width: 100%;
          justify-content: space-between;
          gap: 0.5rem;
        }
        .site-nav a { font-size: 0.85rem; }
        .wrap { padding: 1.5rem 1.1rem 3rem; }
      }
    </style>
  </head>
  <body>
    <header class="masthead">
      <div class="masthead__inner">
        <a class="site-title" href="/">{SITE.name}</a>
        <nav class="site-nav">
          <a href="/posts/">posts</a>
          <a href="/notes/">notes</a>
          <a href="/talks/">presentations</a>
        </nav>
      </div>
    </header>
    <div class="wrap">
      <div class:list={["layout", centered && "layout--centered"]}>
        {!centered && (
        <aside class="sidebar">
          <div class="author">
            <img class="author__avatar" src="/img/me-portrait.jpg?v=3" alt="Adrian Medero" />
            <h3 class="author__name">Adrian Medero <span class="author__handle">(@n0qword)</span></h3>
            <p class="author__bio">Infosec researcher, red teamer, father and husband. You'll find a bit of everything here: random research, experiments and occasional rabbit holes.</p>
            <ul class="author__urls">
              <li><a href={SITE.github} target="_blank" rel="noopener" aria-label="GitHub" title="GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg></a></li>
              <li><a href={SITE.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" title="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg></a></li>
              <li><a href={SITE.twitter} target="_blank" rel="noopener" aria-label="Twitter" title="Twitter"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a></li>
            </ul>
          </div>
        </aside>
        )}
        <main class="content">
          <slot />
        </main>
      </div>
    </div>
    <footer class="page-footer">
      © {year} {SITE.author}
    </footer>
  </body>
</html>
