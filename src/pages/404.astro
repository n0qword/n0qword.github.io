---
import { t, getLocaleFromUrl } from "../i18n";
import Layout from "../layouts/Layout.astro";

const locale = getLocaleFromUrl(Astro.url.pathname);
---

<Layout title={t(locale, "ui.not_found.title")} locale={locale}>
  <h1><em>404</em></h1>
  <p class="page-desc">{t(locale, "ui.not_found.message")}</p>
  <p><a href={"/" + locale + "/"} style="color: var(--red);">{t(locale, "ui.not_found.back_to_home")}</a></p>
</Layout>
