---
/**
 * posts/index.astro — Full post archive page (/posts/).
 *
 * Similar to index.astro but shows ALL posts (no INITIAL_COUNT limit).
 * Reuses the same filter JS from src/scripts/filters.js.
 * The JS detects the absence of #btn-show-more and skips the
 * "show more" behaviour automatically.
 */

import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { frontmatter as SITE } from "../../data/home.md";

const posts = await getCollection("blog");
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const allTags = [...new Set(posts.flatMap((p) => p.data.tags ?? []))].sort();
---

<Layout title={`Posts — ${SITE.name}`} description="Archivo completo de posts">
  <h1><span class="hl">//</span> posts</h1>

  <!-- Post count badge + description -->
  <p class="page-desc">
    <span style="font-family: var(--mono); font-size: 0.65rem; color: var(--red);">{String(posts.length).padStart(2, "0")}</span> &nbsp;Archivo completo de publicaciones
  </p>

  <div class="search-bar">
    <input class="search-input" type="text" id="search" placeholder="buscar posts..." autocomplete="off" />
    <div class="tag-filters" id="tag-filters">
      {allTags.map((tag) => (
        <button class="tag-filter" data-tag={tag}>{tag}</button>
      ))}
    </div>
  </div>

  <ul class="post-list" id="post-list">
    {posts.map((post) => (
      <li data-tags={(post.data.tags ?? []).join(",")}>
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString("es-ES", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </time>
        <a class="post-title" href={`/blog/${post.slug}/`}>{post.data.title}</a>
        <p class="post-excerpt">{post.data.description}</p>
        {post.data.tags && post.data.tags.length > 0 && (
          <ul class="tags-list">
            {post.data.tags.map((tag) => (
              <span class="tag" data-tag={tag}>{tag}</span>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>

  <p id="no-results" style="display: none; color: var(--fg3); font-family: var(--mono); font-size: 0.7rem; text-align: center; padding: 2rem 0;">
    ning&uacute;n post coincide con tu b&uacute;squeda
  </p>

  <script>
    import "../../scripts/filters.js";
  </script>
</Layout>
