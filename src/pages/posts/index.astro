---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { frontmatter as SITE } from "../../data/home.md";

const posts = await getCollection("blog");
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const allTags = [...new Set(posts.flatMap((p) => p.data.tags ?? []))].sort();
const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
const siteName = SITE.name;
---

<Layout title={"Posts — " + siteName} description="Full archive of posts">
  <h1>Posts</h1>
  <p class="page-desc">
    <span class="count">{String(posts.length).padStart(2, "0")}</span> &nbsp;full archive of posts
  </p>
  <div class="search-bar">
    <input class="search-input" type="text" id="search" placeholder="search posts..." autocomplete="off" />
    <div class="tag-filters" id="tag-filters">
      {allTags.map((tag) => (
        <button class="tag-filter" data-tag={tag}>{tag}</button>
      ))}
    </div>
  </div>
  <ul class="post-list" id="post-list">
    {posts.map((post) => (
      <li data-tags={(post.data.tags ?? []).join(",")}>
        <a class="post-card" href={"/blog/" + post.slug + "/"}>
          <div class={post.data.image ? "post-card-cover" : "post-card-cover placeholder"}>
            {post.data.image ? (
              <img src={post.data.image} alt="" loading="lazy" />
            ) : (
              <span class="post-cover-glyph">_</span>
            )}
            <span class="post-card-overlay"></span>
            <div class="post-card-meta">
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="post-card-tags">
                  {post.data.tags.map((tag) => (
                    <span class="tag" data-tag={tag}>{tag}</span>
                  ))}
                </div>
              )}
              <time class="post-card-date" datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
              </time>
            </div>
            <h2 class="post-card-title">{post.data.title}</h2>
          </div>
          <div class="post-card-body">
            <p class="post-card-excerpt">{post.data.description}</p>
          </div>
        </a>
      </li>
    ))}
  </ul>
  <p id="no-results" style="display: none; text-align: center; font-family: var(--mono); font-size: 0.6rem; color: var(--fg3); margin-top: 1.5rem;">
    no posts match your search
  </p>
  <script>import "../../scripts/filters.js";</script>
</Layout>