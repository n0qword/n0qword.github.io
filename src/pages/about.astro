---
import Layout from "../layouts/Layout.astro";
import { frontmatter as SITE } from "../data/home.md";
---

<Layout title={"About — " + SITE.name} description="About n0qword">
  <h1>About</h1>
  <p class="page-desc">
    <span class="count">01</span> &nbsp;who runs this blog
  </p>
  <p>
    I'm <strong>Adrian Medero</strong>, also known as <strong>n0qword</strong> — a
    security researcher and passionate red teamer.
  </p>
  <h2>contact</h2>
  <div class="social-links">
    <a href={SITE.github} target="_blank" rel="noopener">github</a>
    <span class="social-sep">/</span>
    <a href={SITE.twitter} target="_blank" rel="noopener">twitter</a>
    <span class="social-sep">/</span>
    <a href={"mailto:" + SITE.mail}>mail</a>
  </div>
</Layout>