---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { frontmatter as SITE } from "../data/home.md";
import { postDescription } from "../lib/post";

const posts = await getCollection("blog");
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const INITIAL_COUNT = 3;
const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<Layout title={`${SITE.name} research blog`} description={SITE.description}>
  <h1>Recent Posts</h1>
  <div class="page-sep" aria-hidden="true"></div>
  <ul class="post-list" id="post-list">
    {posts.map((post, i) => (
      <li data-tags={(post.data.tags ?? []).join(",")} class={i >= INITIAL_COUNT ? "hidden-more" : ""}>
        <div class="post-item">
          <a class="post-item-title" href={"/posts/" + post.slug + "/"}>{post.data.title}</a>
          <div class="post-item-meta">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            {post.data.tags && post.data.tags.length > 0 && (
              <span class="post-item-taglist">{post.data.tags.join(" / ")}</span>
            )}
          </div>
          <p class="post-item-excerpt">{postDescription(post)}</p>
        </div>
      </li>
    ))}
  </ul>
  {posts.length > INITIAL_COUNT && (
    <button class="btn-show-more" id="btn-show-more">Show more</button>
  )}
  <script>import "../scripts/filters.js";</script>
</Layout>