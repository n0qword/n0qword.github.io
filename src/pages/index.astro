---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { frontmatter as SITE, Content } from "../data/home.md";

const posts = await getCollection("blog");
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const allTags = [...new Set(posts.flatMap((p) => p.data.tags ?? []))].sort();
const INITIAL_COUNT = 3;
const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" });
---

<Layout title={`${SITE.name} research blog`} description={SITE.description}>
  <div class="hero">
    <h1>{SITE.name}</h1>
    <div class="hero-text"><Content /></div>
    <div class="social-links">
      <a href={SITE.github} target="_blank" rel="noopener">github</a>
      <span class="social-sep">/</span>
      <a href={SITE.twitter} target="_blank" rel="noopener">twitter</a>
      <span class="social-sep">/</span>
      <a href={SITE.linkedin} target="_blank" rel="noopener">linkedin</a>
      <span class="social-sep">/</span>
      <a href="/posts/">posts</a>
      <span class="social-sep">/</span>
      <a href={"mailto:" + SITE.mail}>mail</a>
    </div>
  </div>
  <div class="search-bar">
    <input class="search-input" type="text" id="search" placeholder="search posts..." autocomplete="off" />
    <div class="tag-filters" id="tag-filters">
      {allTags.map((tag) => (
        <button class="tag-filter" data-tag={tag}>{tag}</button>
      ))}
    </div>
  </div>
  <ul class="post-list" id="post-list">
    {posts.map((post, i) => (
      <li data-tags={(post.data.tags ?? []).join(",")} class={i >= INITIAL_COUNT ? "hidden-more" : ""}>
        <a class="post-item" href={"/blog/" + post.slug + "/"}>
          <div class="post-item-title">{post.data.title}</div>
          <p class="post-item-excerpt">{post.data.description}</p>
          <div class="post-item-meta">
            <time datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate)}
            </time>
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="post-item-tags">
                {post.data.tags.map((tag) => (
                  <span class="tag" data-tag={tag}>{tag}</span>
                ))}
              </div>
            )}
          </div>
        </a>
      </li>
    ))}
  </ul>
  {posts.length > INITIAL_COUNT && (
    <button class="btn-show-more" id="btn-show-more">show more</button>
  )}
  <p id="no-results" style="display: none; text-align: center; font-family: var(--mono); font-size: 0.75rem; color: var(--fg3); margin-top: 1.5rem;">
    no posts match your search
  </p>
  <script>import "../scripts/filters.js";</script>

  <style>
    .hero {
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
      border-bottom: 1px solid var(--line);
    }
    .hero h1 {
      font-family: var(--mono);
      font-size: 1.1rem;
      font-weight: 500;
      margin-bottom: 0.5rem;
    }
    .hero-text {
      color: var(--fg2);
      font-size: 0.9rem;
      margin-bottom: 0.8rem;
      line-height: 1.7;
    }
    .hero-text p { margin: 0; }
  </style>
</Layout>
