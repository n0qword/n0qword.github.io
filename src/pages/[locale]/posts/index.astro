---
import { t, type Locale } from "../../../i18n";
import Layout from "../../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { frontmatter as SITE } from "../../../data/home.md";

export async function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "es" } }];
}

const { locale } = Astro.params as { locale: Locale };
const posts = await getCollection("blog");
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const allTags = [...new Set(posts.flatMap((p) => p.data.tags ?? []))].sort();
const siteName = locale === "es" ? SITE.name : t(locale, "site.name");
---

<Layout title={t(locale, "ui.posts.title") + " — " + siteName} description={t(locale, "ui.posts.description")} locale={locale}>
  <h1><span class="hl">//</span> {t(locale, "ui.posts.title")}</h1>
  <p class="page-desc">
    <span style="font-family: var(--mono); font-size: 0.65rem; color: var(--red);">
      {String(posts.length).padStart(2, "0")}
    </span> &nbsp;{t(locale, "ui.posts.description")}
  </p>
  <div class="search-bar">
    <input class="search-input" type="text" id="search" placeholder={t(locale, "ui.home.search_placeholder")} autocomplete="off" />
    <div class="tag-filters" id="tag-filters">
      {allTags.map((tag) => (
        <button class="tag-filter" data-tag={tag}>{tag}</button>
      ))}
    </div>
  </div>
  <ul class="post-list" id="post-list">
    {posts.map((post) => (
      <li data-tags={(post.data.tags ?? []).join(",")}>
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString(locale === "en" ? "en-US" : "es-ES", { year: "numeric", month: "long", day: "numeric" })}
        </time>
        <a class="post-title" href={"/" + locale + "/blog/" + post.slug + "/"}>{post.data.title}</a>
        <p class="post-excerpt">{post.data.description}</p>
        {post.data.tags && post.data.tags.length > 0 && (
          <ul class="tags-list">
            {post.data.tags.map((tag) => (
              <span class="tag" data-tag={tag}>{tag}</span>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
  <p id="no-results" style="display: none; text-align: center; font-family: var(--mono); font-size: 0.6rem; color: var(--fg3); margin-top: 1.5rem;">
    {t(locale, "ui.home.no_results")}
  </p>
  <script>import "../../../scripts/filters.js";</script>
</Layout>
