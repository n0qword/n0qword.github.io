---
import { t, type Locale } from "../../i18n";
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { frontmatter as SITE, Content } from "../../data/home.md";

export async function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "es" } }];
}

const { locale } = Astro.params as { locale: Locale };
const posts = await getCollection("blog");
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const allTags = [...new Set(posts.flatMap((p) => p.data.tags ?? []))].sort();
const INITIAL_COUNT = 3;
const siteName = locale === "es" ? SITE.name : t(locale, "site.name");
const desc = locale === "es" ? SITE.description : t(locale, "site.description");
---

<Layout title={siteName} description={desc} locale={locale}>
  <h1><span class="hl">//</span> {siteName}</h1>
  <div class="hero">
    {locale === "es" ? <Content /> : <div class="hero-text">{t(locale, "site.bio")}</div>}
    <div class="social-links">
      <a href={SITE.github} target="_blank">github</a>
      <span class="social-sep">/</span>
      <a href={SITE.twitter} target="_blank">twitter</a>
      <span class="social-sep">/</span>
      <a href={"/" + locale + "/posts/"}>posts</a>
      <span class="social-sep">/</span>
      <a href={"mailto:" + SITE.mail}>mail</a>
    </div>
  </div>
  <div class="search-bar">
    <input class="search-input" type="text" id="search" placeholder={t(locale, "ui.home.search_placeholder")} autocomplete="off" />
    <div class="tag-filters" id="tag-filters">
      {allTags.map((tag) => (
        <button class="tag-filter" data-tag={tag}>{tag}</button>
      ))}
    </div>
  </div>
  <ul class="post-list" id="post-list">
    {posts.map((post, i) => (
      <li data-tags={(post.data.tags ?? []).join(",")} class={i >= INITIAL_COUNT ? "hidden-more" : ""}>
        <time datetime={post.data.pubDate.toISOString()}>
          {post.data.pubDate.toLocaleDateString(locale === "en" ? "en-US" : "es-ES", { year: "numeric", month: "long", day: "numeric" })}
        </time>
        <a class="post-title" href={"/" + locale + "/blog/" + post.slug + "/"}>{post.data.title}</a>
        <p class="post-excerpt">{post.data.description}</p>
        {post.data.tags && post.data.tags.length > 0 && (
          <ul class="tags-list">
            {post.data.tags.map((tag) => (
              <span class="tag" data-tag={tag}>{tag}</span>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
  {posts.length > INITIAL_COUNT && (
    <button class="btn-show-more" id="btn-show-more">{t(locale, "ui.home.show_more")}</button>
  )}
  <p id="no-results" style="display: none; text-align: center; font-family: var(--mono); font-size: 0.6rem; color: var(--fg3); margin-top: 1.5rem;">
    {t(locale, "ui.home.no_results")}
  </p>
  <script>import "../../scripts/filters.js";</script>
</Layout>
